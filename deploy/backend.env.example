# Backend settings for the server. setup-server.sh fills in the __ values.
NODE_ENV=production
PORT=3000

# Database on this server
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nowrj_app
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=nowrj

# Sign-in sessions
SESSION_SECRET=__SESSION_SECRET__

# The website's address (sign-in sends people back here)
FRONTEND_URL=https://__DOMAIN__

# Google sign-in: add this exact callback URL in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://__DOMAIN__/api/auth/google/callback

# Comma-separated Google emails with Super Admin access
SUPERADMIN_EMAILS=
